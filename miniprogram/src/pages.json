{
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/menu/index",
			"style": {
				"navigationBarTitleText": "点单"
			}
		},
		{
			"path": "pages/ai/index",
			"style": {
				"navigationBarTitleText": "AI 点单"
			}
		},
		{
			"path": "pages/order/index",
			"style": {
				"navigationBarTitleText": "我的订单"
			}
		},
		{
			// 购物车为菜单页浮动球入口（页面栈跳转，非 Tab，LLD 8.1）
			"path": "pages/cart/index",
			"style": {
				"navigationBarTitleText": "购物车"
			}
		},
		{
			// 支付确认页（T26）：创建订单后进入，金额以后端为准
			"path": "pages/pay-confirm/index",
			"style": {
				"navigationBarTitleText": "确认支付"
			}
		},
		{
			// 拼单页（T64，W13）：未带 uuid 进来则创建池，带 uuid 则加入；含冻结与结算。
			// 非 Tab —— 从菜单页/我的订单页按需进入（与购物车同属页面栈跳转）
			"path": "pages/group/index",
			"style": {
				"navigationBarTitleText": "拼单"
			}
		},
		{
			// 代取凭证页（T65，W15）：凭令牌进入的**公开页**，打开即核销（一次性）。
			// 代取人可能从未登录过，故不依赖登录态；授权由 token 自身承担
			"path": "pages/delegate/index",
			"style": {
				"navigationBarTitleText": "代取凭证"
			}
		},
		{
			"path": "pages/order-detail/index",
			"style": {
				"navigationBarTitleText": "订单详情"
			}
		}
	],
	// TabBar 三项（LLD 8.1）：菜单 / AI 点单 / 订单；图标为模板占位（联调期替换正式图标）
	"tabBar": {
		"color": "#909399",
		"selectedColor": "#409eff",
		"backgroundColor": "#ffffff",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/menu/index",
				"text": "菜单"
			},
			{
				"pagePath": "pages/ai/index",
				"text": "AI 点单"
			},
			{
				"pagePath": "pages/order/index",
				"text": "订单"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "奶茶在线点单",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F5F6F8"
	}
}
