# 用法：cp .env.example .env 后填入真实值
# 注意：MinIO 密码不足 8 位容器会直接起不来（Invalid credentials）
MYSQL_ROOT_PASSWORD=change_me_at_least_8_chars
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me_at_least_8_chars

# JWT 签名密钥（HS256，至少 32 字节）。生产环境务必通过 JWT_SECRET 环境变量注入，勿写死在仓库
# Spring Boot 会将环境变量 JWT_SECRET 映射为属性 jwt.secret（宽松绑定）
JWT_SECRET=change_me_at_least_32_bytes_random_secret
