# 用法：复制为 backend/.env 并填入真实值（backend/.env 已 gitignore，禁止提交）
# 未提供 .env 时，应用回落到 application-dev.yml 中的 localhost 默认值
# 本机起基础设施：cd docker && docker compose --profile infra up -d

# MySQL 连接串（本地 infra 端口映射为 3307）
DEV_DB_URL=jdbc:mysql://localhost:3307/milk_tea?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=1234

# MinIO（endpoint 用 S3 API 端口 9000，非控制台 9001）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=12345678
MINIO_BUCKET=dev-bucket

# JWT HS256 签名密钥（≥ 32 字节，生产务必更换）
JWT_SECRET=change_me_at_least_32_bytes_random_secret

# AI 点单模型密钥（GLM OpenAI 兼容端点）
AI_API_KEY=your_glm_api_key_here

# 微信小程序 AppSecret（本地 dev-login 通道可留空）
WX_SECRET=
# 微信开发工具appid
APP_ID=
